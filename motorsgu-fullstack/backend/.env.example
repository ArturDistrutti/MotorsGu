# Copie este arquivo para ".env" e ajuste os valores antes de rodar o servidor.

# Porta em que a API vai rodar.
PORT=3001

# Segredo usado para assinar os tokens de login (JWT).
# IMPORTANTE: troque por um valor longo e aleatório antes de publicar.
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Por quanto tempo o login do admin fica válido.
JWT_EXPIRES_IN=12h

# Origem do site que pode chamar a API (o front-end).
# Em produção, use o domínio real do site, por exemplo: https://motorsgu.com.br
CORS_ORIGIN=http://localhost:5500
